rule target:
    input:
        "notebooks/notebook1.pdf",
        "data/wrangled/seed_size.csv"

rule render:
    input:
        "notebooks/notebook1.qmd"
    output:
        "notebooks/notebook1.pdf"
    log:
        "results/logs/notebook1.log"
    conda:
        "envs/environment.yaml"
    shell:
        """
        (quarto render {input} --to pdf) 2> {log}
        """

rule seed_size:
    output:
        "data/wrangled/seed_size.csv"
    log:
        log="results/logs/wrangling/seed_size.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/get_seed_size.R"
