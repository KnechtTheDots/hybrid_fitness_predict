rule target:
    input:
        "notebooks/notebook1.pdf",
        "data/wrangled/seed_size_germ_day.csv",
        "data/wrangled/seedling_areas.csv",
        "data/wrangled/survival.csv"

rule render:
    input:
        "notebooks/notebook1.qmd"
    output:
        "notebooks/notebook1.pdf"
    log:
        "results/logs/notebook1.log"
    conda:
        "envs/environment.yaml"
    shell:
        """
        (quarto render {input} --to pdf) 2> {log}
        """

rule wrangling:
    output:
        seeds="data/wrangled/seed_size_germ_day.csv",
        seedlings="data/wrangled/seedling_areas.csv",
        survival="data/wrangled/survival.csv"
    log:
        log="results/logs/wrangling.log"
    conda:
        "envs/environment.yaml"
    script:
        "scripts/wrangling.R"
